{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": [
        "./*"
      ]
    }
  },
  "include": [
    "."
  ]
}
