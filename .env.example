# PostgreSQL connection used by the API and the setup script.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/lm_inspect
# Port the Express API listens on (Vite proxies /api here).
API_PORT=4000
# Secret used to sign session tokens. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# One-time-code delivery. Leave unset to show codes on screen (demo mode).
# E-mail via any SMTP account (Gmail: smtp.gmail.com, port 587, an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LMPC Inspection <you@example.com>
# SMS via Twilio (trial accounts can text verified numbers only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Set to false to refuse resets when no channel could deliver (production).
OTP_SHOW_ON_SCREEN=true
